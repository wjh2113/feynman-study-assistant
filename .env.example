DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
PORT=8787

# 部署模式：
#   standalone — 单机：PGlite 落盘（.data/postgres）+ 本地原文件（.data/uploads）+ 可选内存队列
#   cloud      — 云模式（默认）：生产要求 DATABASE_URL + Redis + 远程对象存储
# 也可用 STANDALONE=true
DEPLOY_MODE=standalone

# OCR 提供商：qwen（阿里云百炼）或 baidu（百度智能云通用文字识别）
VISION_PROVIDER=qwen
# 百炼 Qwen OCR（VISION_PROVIDER=qwen）
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_API_KEY=
VISION_MODEL=qwen3.5-ocr
# 百度智能云 OCR（VISION_PROVIDER=baidu）— 在控制台创建应用后填写 AK/SK
# BAIDU_OCR_API_KEY=
# BAIDU_OCR_SECRET_KEY=
# 也可沿用 VISION_API_KEY + VISION_SECRET_KEY
# VISION_SECRET_KEY=
# 单份资料 OCR 张数的默认值（新用户 / 未改个人设置时）；实际以「个人设置 → 图片 OCR」为准
OCR_MAX_IMAGES=40
# 小于该字节数的内嵌图视为装饰图并跳过 OCR
OCR_MIN_IMAGE_BYTES=4096
OCR_CONCURRENCY=3

# 留空时使用项目内置的可落盘 PostgreSQL（PGlite + pgvector）→ .data/postgres
# 单机模式可一直留空；云模式生产必须填写标准 PostgreSQL
# DATABASE_URL=postgresql://zhifan:password@10.x.x.x:5432/zhifan
DATABASE_URL=
# false | true | require | verify
DATABASE_SSL=false
# DATABASE_SSL_CA=
DATABASE_POOL_MAX=10
DATA_DIR=.data
# 单机模式可留空（内存队列）；云模式生产必须配置 Redis
REDIS_URL=

# 生产环境必须设置为至少 32 字节随机值；用于 AES-256-GCM 加密模型密钥
APP_ENCRYPTION_KEY=

# 文件存储：
#   local   — 服务器磁盘 .data/uploads（单机模式推荐）
#   jdcloud — 京东云 OSS（S3 兼容，云模式推荐）
#   s3      — 通用 S3 兼容
#   oss     — 阿里云 OSS（ali-oss SDK）
STORAGE_PROVIDER=local

# 京东云 OSS / 通用 S3（STORAGE_PROVIDER=jdcloud 或 s3）
S3_REGION=cn-north-1
S3_ENDPOINT=https://s3.cn-north-1.jdcloud-oss.com
# 同地域云主机建议改用内网：
# S3_ENDPOINT=https://s3-internal.cn-north-1.jdcloud-oss.com
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY_SECRET=
S3_FORCE_PATH_STYLE=true

# 阿里云 OSS（仅 STORAGE_PROVIDER=oss 时需要）
OSS_REGION=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 邮件与提醒
PUBLIC_BASE_URL=http://127.0.0.1:8787
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 支付；无商户凭据时使用 sandbox
PAYMENT_PROVIDER=sandbox
PAYMENT_SANDBOX=true
PAYMENT_WEBHOOK_SECRET=
WECHATPAY_MCH_ID=
WECHATPAY_PRIVATE_KEY=
WECHATPAY_PLATFORM_CERT=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# 模型超时与慢请求阈值
RETRIEVAL_TIMEOUT_MS=30000
GENERATION_TIMEOUT_MS=90000
SLOW_REQUEST_MS=5000

# 检索模型：默认使用阿里云百炼云端 Embedding/Reranker
# 配置后不会再启动本地 Python BGE 服务，可删除 .data/models 和 .tools/python311
EMBEDDING_PROVIDER=remote
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

RERANKER_PROVIDER=remote
RERANKER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RERANKER_API_KEY=
RERANKER_MODEL=gte-rerank

RAG_RELEVANCE_THRESHOLD=0.35
BGE_AUTO_START=false

# 生产环境必须配置浏览器实际访问来源，多个来源用逗号分隔
# ALLOWED_ORIGINS=https://study.example.com
# 仅在应用位于可信反向代理之后设置，例如 TRUST_PROXY=loopback
# TRUST_PROXY=

# 其他可选云端 Embedding/Reranker 示例
# SiliconFlow: EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#              EMBEDDING_MODEL=BAAI/bge-m3
#              RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# OpenAI:      EMBEDDING_BASE_URL=https://api.openai.com/v1
#              EMBEDDING_MODEL=text-embedding-3-large
#              RERANKER_BASE_URL=https://api.openai.com/v1
